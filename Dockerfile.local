FROM eclipse-temurin:21-jdk-jammy AS build
WORKDIR /src
COPY app/App.java app/AppTest.java ./
RUN mkdir classes && javac --release 21 -d classes App.java AppTest.java && java -cp classes AppTest && rm classes/AppTest.class && jar --create --file app.jar --main-class App -C classes .
FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
COPY --from=build --chown=10001:10001 /src/app.jar /app/app.jar
ENV PORT=8080
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=70.0", "-jar", "/app/app.jar"]
